@startuml SpeechToTextService

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor White
    BorderColor #2E75B6
    HeaderBackgroundColor #D6E4F0
    FontName Arial
}

class SpeechToTextService {
    - filename : str = "input.wav"
    - fs : int = 16000
    - model : whisper.Whisper
    --
    + record_audio(filename: str, duration: int, fs: int) : None
    + speech_to_text(filename: str) : str
    + main() : None
}


class "whisper.Whisper" <<external>> {
}

class "sounddevice" <<library>> {
}

class "scipy.io.wavfile" <<library>> {
}

class "soundfile" <<library>> {
}

class "numpy" <<library>> {
}

class "output.txt" <<file>> {
}

SpeechToTextService ..> "whisper.Whisper"       : <<uses>>
SpeechToTextService ..> "sounddevice"            : <<uses>>
SpeechToTextService ..> "scipy.io.wavfile"       : <<uses>>
SpeechToTextService ..> "soundfile"              : <<uses>>
SpeechToTextService ..> "numpy"                  : <<uses>>
SpeechToTextService ..> "output.txt"             : <<writes>>

@enduml